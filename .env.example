# Copy this file to ".env" and fill it in. Never share or upload the real .env file.

PORT=3000

# A long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Your admin account. It is created the first time the server starts.
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=choose-a-strong-password

# false = you approve each new vendor from the admin page (recommended)
# true  = vendors can sell straight after signing up (handy while testing)
AUTO_APPROVE_VENDORS=false

# ---- Customer login codes ----
# On your own computer you do not need email yet: the 6-digit code is printed in the terminal
# where the server is running. Leave the SMTP lines empty for now.
#
# Optional shortcut for testing on your own computer ONLY: show the code on the login page too.
# DELETE this line before going live. The server refuses to start in production if it is on.
DEV_SHOW_CODE=true

# When you go live, fill these in with an email service (Brevo, Mailgun, Gmail app password, etc.)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Vendorfy <no-reply@vendorfy.shop>
